{
  "name": "field-service-operations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:customer": "vite --host 127.0.0.1 --mode customer",
    "start": "node server.mjs",
    "build": "tsc --noEmit && vite build",
    "build:customer": "tsc --noEmit && vite build --mode customer",
    "typecheck": "tsc --noEmit",
    "test": "node --test ../../shared/contracts/*.test.ts src/state/*.test.ts src/assistant/*.test.ts",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@syncfusion/ej2-layouts": "34.2.8",
    "@syncfusion/ej2-react-buttons": "34.2.8",
    "@syncfusion/ej2-react-calendars": "34.2.8",
    "@syncfusion/ej2-react-charts": "34.2.8",
    "@syncfusion/ej2-react-dropdowns": "34.2.8",
    "@syncfusion/ej2-react-grids": "34.2.8",
    "@syncfusion/ej2-react-inputs": "34.2.8",
    "@syncfusion/ej2-react-interactive-chat": "34.2.8",
    "@syncfusion/ej2-react-kanban": "34.2.8",
    "@syncfusion/ej2-react-popups": "34.2.8",
    "@syncfusion/ej2-tailwind3-dark-theme": "34.2.8",
    "@syncfusion/ej2-tailwind3-theme": "34.2.8",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
